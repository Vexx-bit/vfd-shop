# ==========================================
# Victory Fashion Designers - Environment Variables
# Copy this file to .env.local for local development
# Add these to Vercel Environment Variables for production
#
# NEVER put real secrets in this file. It is committed to git.
# ==========================================

# ==========================================
# Database (Neon Postgres)
# ==========================================

# Use the POOLED connection string from the Neon dashboard (the host contains
# "-pooler"). Server-only — do NOT prefix this with NEXT_PUBLIC_.
# Neon's free tier does not auto-pause, so no keep-alive cron is needed.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ==========================================
# Admin dashboard
# ==========================================

# REQUIRED. Without it, /admin and /api/admin/* refuse every request — there is
# no default PIN any more. Treat this as a password rather than a 4-digit code:
# it is the only thing between the internet and your orders table.
ADMIN_PIN=change-me-to-something-long

# Optional but recommended. Signs the admin session cookie. If unset, the key
# is derived from ADMIN_PIN and is only as strong as the PIN itself.
# Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ==========================================
# Application Configuration
# ==========================================

# Canonical site URL. Used for sitemap, robots, Open Graph and share links.
NEXT_PUBLIC_SITE_URL=https://vfd-shop.vercel.app

# ==========================================
# Image watermarking (/api/img)
# ==========================================

# Extra image hosts the watermark route is allowed to fetch from, comma
# separated. Same-origin images and a few common CDNs are allowed by default.
# Anything not allowlisted is served unbranded rather than blocked.
IMAGE_PROXY_ALLOWED_HOSTS=

# ==========================================
# M-Pesa Daraja API — NOT CURRENTLY IN USE
# ==========================================

# Orders are placed over WhatsApp, so none of this is required for the site to
# work. The /api/mpesa-* routes stay dormant while these are empty. Fill them in
# only if you switch M-Pesa checkout back on.

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_PAYBILL=
MPESA_ACCOUNT=
MPESA_CALLBACK_URL=
C2B_VALIDATION_URL=
C2B_CONFIRMATION_URL=

# ==========================================
# Email Configuration (Optional - order notifications)
# ==========================================

EMAIL_SERVICE_ID=your_service_id
EMAIL_TEMPLATE_ID=your_template_id
EMAIL_PUBLIC_KEY=your_public_key

# ==========================================
# NOTES FOR DEPLOYMENT
# ==========================================

# 1. VERCEL SETUP
#    - Import this GitHub repository at vercel.com
#    - Add every variable above under Settings → Environment Variables
#    - Redeploy after adding or changing variables
#
# 2. NEON SETUP
#    - Create a project at neon.tech
#    - Copy the pooled connection string into DATABASE_URL
#    - The schema lives in db/schema.sql
#    - Seed sample products from the admin dashboard ("Seed products")
#
# 3. ADMIN ACCESS
#    - Set ADMIN_PIN, then sign in at /admin/login
#    - Sessions last 8 hours and live in an httpOnly cookie
#    - Changing ADMIN_PIN or ADMIN_SESSION_SECRET signs everyone out
#
# 4. IF CREDENTIALS WERE EVER COMMITTED
#    - Rotate them. Git history keeps old versions of this file forever.
#    - The M-Pesa sandbox keys and EmailJS key once committed here are still
#      readable in history. Revoke the Daraja app if you are not using it.
