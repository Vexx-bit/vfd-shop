# ==========================================
# Victory Fashion Designers - Environment Variables
# Copy this file to .env.local for local development
# Add these to Vercel Environment Variables for production
#
# NEVER put real secrets in this file. It is committed to git.
# ==========================================

# ==========================================
# Database (Neon Postgres)
# ==========================================

# Use the POOLED connection string from the Neon dashboard (the host contains
# "-pooler"). Server-only — do NOT prefix this with NEXT_PUBLIC_.
# Neon's free tier does not auto-pause, so no keep-alive cron is needed.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ==========================================
# Admin dashboard
# ==========================================

# PIN required by the /admin dashboard (sent as the x-admin-pin header).
# Set a real value here so it is not baked into the source code.
ADMIN_PIN=change-me

# ==========================================
# M-Pesa Daraja API Credentials
# ==========================================

# Switch to "production" once your Daraja app is live. Anything else uses sandbox.
MPESA_ENV=sandbox

# Get these from https://developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret

# M-Pesa Shortcode (Sandbox default is 174379)
MPESA_SHORTCODE=174379

# M-Pesa Passkey (Daraja portal → test credentials for sandbox)
MPESA_PASSKEY=your-passkey

# PayBill Configuration (production)
MPESA_PAYBILL=your-paybill
MPESA_ACCOUNT=your-account-number

# Callback URL (Your domain + /api/mpesa-callback)
MPESA_CALLBACK_URL=https://your-domain.vercel.app/api/mpesa-callback

# C2B URLs
C2B_VALIDATION_URL=https://your-domain.vercel.app/api/c2b-validation
C2B_CONFIRMATION_URL=https://your-domain.vercel.app/api/c2b-confirmation

# ==========================================
# Application Configuration
# ==========================================

# Canonical site URL. Used for sitemap, robots, Open Graph and share links.
NEXT_PUBLIC_SITE_URL=https://vfd-shop.vercel.app

# ==========================================
# Image watermarking (/api/img)
# ==========================================

# Extra image hosts the watermark route is allowed to fetch from, comma
# separated. Same-origin images and a few common CDNs are allowed by default.
# Anything not allowlisted is served unbranded rather than blocked.
IMAGE_PROXY_ALLOWED_HOSTS=

# ==========================================
# Email Configuration (Optional - order notifications)
# ==========================================

EMAIL_SERVICE_ID=your_service_id
EMAIL_TEMPLATE_ID=your_template_id
EMAIL_PUBLIC_KEY=your_public_key

# ==========================================
# NOTES FOR DEPLOYMENT
# ==========================================

# 1. VERCEL SETUP
#    - Import this GitHub repository at vercel.com
#    - Add every variable above under Settings → Environment Variables
#    - Redeploy after adding or changing variables (they are read at build time)
#
# 2. NEON SETUP
#    - Create a project at neon.tech
#    - Copy the pooled connection string into DATABASE_URL
#    - The schema lives in db/schema.sql
#    - Seed sample products from the admin dashboard ("Seed products")
#
# 3. M-PESA PRODUCTION
#    - Go Live on the Daraja portal and swap in production credentials
#    - Set MPESA_ENV=production
#    - Update MPESA_CALLBACK_URL to your production domain
#    - Register C2B URLs via the Daraja API
#
# 4. TESTING
#    - Sandbox test numbers: 254708374149, 254722000000
#    - Test amounts: 1, 10, 100, 1000
#    - Watch callbacks in the Vercel function logs
#
# 5. IF CREDENTIALS WERE EVER COMMITTED
#    - Rotate them. Git history keeps old versions of this file forever.
